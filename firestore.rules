rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Helpers
    function isValidUserPublic(data) {
      return data.keys().hasAll(['userId', 'displayName'])
        && data.userId == request.auth.uid
        && data.displayName is string && data.displayName.size() <= 100
        && (!('lastWorkoutId' in data) || (data.lastWorkoutId is string && data.lastWorkoutId.size() <= 128))
        && (!('lastWorkoutDate' in data) || (data.lastWorkoutDate is string || data.lastWorkoutDate is timestamp));
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll(['email'])
        && data.email == request.auth.token.email
        && data.email is string && data.email.size() <= 200;
    }

    function isValidExerciseWeight(data) {
      return data.keys().hasAll(['exerciseId', 'weight', 'reps', 'updatedAt'])
        && data.exerciseId is string && data.exerciseId.size() <= 128
        && data.weight is number && data.weight >= 0
        && data.reps is number && data.reps >= 0
        && (data.updatedAt is timestamp || data.updatedAt == request.time);
    }

    function isValidWorkoutSession(data) {
      return data.keys().hasAll(['userId', 'workoutId', 'workoutName', 'date', 'exercises'])
        && data.userId == request.auth.uid
        && data.workoutId is string && data.workoutId.size() <= 128
        && data.workoutName is string && data.workoutName.size() <= 100
        && (data.date is timestamp || data.date == request.time)
        && data.exercises is list && data.exercises.size() <= 50;
    }

    function isValidCustomWorkouts(data) {
      return data.keys().hasAll(['workouts', 'updatedAt'])
        && data.workouts is list && data.workouts.size() <= 30
        && (data.updatedAt is timestamp || data.updatedAt == request.time);
    }

    // Collection Rules
    match /users/{userId} {
      match /public/prof {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) && isValidUserPublic(incoming());
      }
      match /private/info {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidUserPrivate(incoming());
      }
      match /weights/{exerciseId} {
        allow list, get: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(exerciseId) && isValidExerciseWeight(incoming());
      }
      match /sessions/{sessionId} {
        allow list, get: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(sessionId) && isValidWorkoutSession(incoming());
      }
      match /config/{configId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && configId == 'workouts' && isValidCustomWorkouts(incoming());
      }
    }
  }
}
